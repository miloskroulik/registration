<?php

/**
 * @file
 * Provides user registration for events.
 */

use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Link;
use Drupal\Core\Render\Element;
use Drupal\Core\Url;
use Drupal\registration\Entity\RegistrationInterface;
use Drupal\user\UserInterface;
use Drupal\field\Entity\FieldConfig;

/**
 * Implements hook_entity_extra_field_info().
 *
 * @see function registration_registration_view().
 */
function registration_entity_extra_field_info() {
  // Add extra display fields for calculated registration data.
  $extra = [];
  $registration_types = \Drupal::service('entity_type.bundle.info')->getBundleInfo('registration');
  foreach ($registration_types as $type => $info) {
    $extra['registration'][$type]['display']['host_entity'] = [
      'label' => t('Host entity'),
      'description' => t('Host entity pseudo field.'),
      'weight' => 0,
      'visible' => TRUE,
    ];
  }
  return $extra;
}

/**
 * Implements hook_ENTITY_TYPE_view().
 *
 * @see function registration_entity_extra_field_info().
 */
function registration_registration_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode) {
  // Determine the label display to use for extra fields by looking at others.
  $label_display = 'above';
  $components = $display->getComponents();
  foreach ($components as $id => $component) {
    if (!empty($component['label'])) {
      $label_display = $component['label'];
      break;
    }
  }

  // Add the extra fields.
  if ($display->getComponent('host_entity')) {
    if ($host_entity = $entity->getHostEntity()) {
      $build['host_entity'] = [
        '#theme' => 'field',
        '#label_display' => $label_display,
        '#view_mode' => '_custom',
        '#title' => $host_entity->getEntityType()->getLabel(),
        '#field_type' => 'text',
        '#field_name' => 'host_entity',
        '#bundle' => $entity->bundle(),
        '#entity_type' => $entity->getEntityTypeId(),
        '#object' => $entity,
        '#is_multiple' => FALSE,
        '#items' => [],
        0 => [
          '#markup' => Link::fromTextAndUrl($host_entity->label(), $host_entity->toUrl())->toString(),
        ],
      ];
    }
  }
}

/**
 * Implements hook_theme().
 */
function registration_theme(): array {
  return [
    'registration_form' => [
      'render element' => 'form',
    ],
    'registration' => [
      'render element' => 'elements',
    ],
  ];
}

/**
 * Prepares variables for a registration.
 *
 * Default template: registration.html.twig.
 *
 * @param array $variables
 *   An associative array containing:
 *   - elements: An associative array containing rendered fields.
 *   - attributes: HTML attributes for the containing element.
 */
function template_preprocess_registration(array &$variables) {
  /** @var Drupal\registration\Entity\RegistrationInterface $registration */
  $registration = $variables['elements']['#registration'];

  $variables['registration_entity'] = $registration;
  $variables['registration'] = [];
  foreach (Element::children($variables['elements']) as $key) {
    $variables['registration'][$key] = $variables['elements'][$key];
  }
}

/**
 * Implements hook_entity_operation().
 */
function registration_entity_operation(EntityInterface $entity) {
  $operations = [];
  if (($entity instanceof RegistrationInterface) && $entity->access('view')) {
    // Add a View operation for registrations. This will be first, followed
    // by the Edit and Delete operations (if the user has those permissions).
    $operations['view'] = [
      'title' => t('View'),
      'url' => Url::fromRoute('entity.registration.canonical', [
        'registration' => $entity->id(),
      ]),
      'weight' => -1,
    ];
  }
  return $operations;
}

/**
 * Implements hook_entity_insert().
 */
function registration_entity_insert(EntityInterface $entity) {
  // Rebuild routes and local tasks when Registration fields are added.
  if ($entity instanceof FieldConfig) {
    if ($entity->getType() == 'registration') {
      \Drupal::service('plugin.manager.menu.local_task')->clearCachedDefinitions();
      \Drupal::service("router.builder")->rebuild();
    }
  }
}

/**
 * Implements hook_entity_delete().
 */
function registration_entity_delete(EntityInterface $entity) {
  // Delete registrations and settings for this host entity.
  \Drupal::database()->delete('registration')
    ->condition('entity_type_id', $entity->getEntityTypeId())
    ->condition('entity_id', $entity->id())
    ->execute();
  \Drupal::database()->delete('registration_entity')
    ->condition('entity_type_id', $entity->getEntityTypeId())
    ->condition('entity_id', $entity->id())
    ->execute();

  // Rebuild routes and local tasks when Registration fields are deleted.
  if ($entity instanceof FieldConfig) {
    if ($entity->getType() == 'registration') {
      \Drupal::service('plugin.manager.menu.local_task')->clearCachedDefinitions();
      \Drupal::service("router.builder")->rebuild();
    }
  }
}

/**
 * Implements hook_entity_presave().
 */
function registration_entity_presave(EntityInterface $entity) {
  // This is done here instead of the preSave class method to
  // avoid updating the changed time if the only change to the
  // entity is the result of a user changing their email address.
  // This hook runs after the ChangedItem field presave hook,
  // which updates the changed time if field changes are detected.
  if ($entity instanceof RegistrationInterface) {
    // Always recompute email address since it is derived from other fields.
    if ($user = $entity->getUser()) {
      $entity->set('mail', $user->getEmail());
    }
    else {
      $entity->set('mail', $entity->getAnonymousEmail());
    }
  }
}

/**
 * Implements hook_entity_update().
 */
function registration_entity_update(EntityInterface $entity) {
  // Update registrations if a user changes their email.
  // The email address field is computed and saved for
  // use in filtering and sorting in various listings.
  if (($entity instanceof UserInterface) && isset($entity->original)) {
    if ($entity->getEmail() != $entity->original->getEmail()) {
      $query = \Drupal::database()->select('registration', 'r');
      $query->addField('r', 'registration_id');
      $query->condition('r.user_uid', $entity->id());
      $result = $query->execute()->fetchCol();

      // @todo use a queue if there are too many to update at once.
      $storage = \Drupal::entityTypeManager()->getStorage('registration');
      $registrations = $storage->loadMultiple($result);
      foreach ($registrations as $registration) {
        // This updates the email address and clears cache.
        $registration->save();
      }
    }
  }

  // If a form display for a registration field is updated, clear
  // the local task plugin cache so local tasks (tabs) are rebuilt,
  // in case the Hide Register Tab field setting may have changed.
  if ($entity instanceof EntityFormDisplay) {
    $entity_types = \Drupal::entityTypeManager()->getDefinitions();
    $entity_type = $entity_types[$entity->getTargetEntityTypeId()];
    if (\Drupal::service('registration.manager')->hasRegistrationField($entity_type)) {
      \Drupal::service('plugin.manager.menu.local_task')->clearCachedDefinitions();
    }
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function registration_form_views_exposed_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  $view = $form_state->get('view');
  if (($view->id() == 'manage_registrations')) {
    // Hide the manage registrations filter when there are only a few rows.
    $route_match = \Drupal::routeMatch();
    $registration_manager = \Drupal::service('registration.manager');
    if ($host_entity = $registration_manager->getEntityFromParameters($route_match->getParameters())) {
      $settings = $registration_manager->getSettingsForHost($host_entity);
      if ($registration_manager->getRegistrationCount($host_entity, $settings) < 10) {
        $form['mail']['#access'] = FALSE;
        $form['actions']['#access'] = FALSE;
      }
    }
  }
}

/**
 * Implements hook_views_data().
 */
function registration_views_data() {
  $data['views']['manage_registrations_caption'] = [
    'title' => t('Manage registrations caption'),
    'help' => t('Displays a caption for the Manage Registrations listing.'),
    'area' => [
      'id' => 'manage_registrations_caption',
    ],
  ];
  $data['views']['manage_registrations_empty'] = [
    'title' => t('Manage registrations empty'),
    'help' => t('Displays an empty notice for the Manage Registrations listing.'),
    'area' => [
      'id' => 'manage_registrations_empty',
    ],
  ];
  return $data;
}

/**
 * Implements hook_views_data_alter().
 */
function registration_views_data_alter(array &$data) {
  foreach (\Drupal::service('registration.manager')->getRegistrationEnabledEntityTypes() as $entity_type) {
    $id = $entity_type->id();
    $base_table = $entity_type->getBaseTable();
    $data[$base_table][$base_table . 'registration_settings'] = [
      'title' => t('@type registration settings', [
        '@type' => $entity_type->getLabel(),
      ]),
      'help' => t('Relate @type to their registration settings.', [
        '@type' => $entity_type->getPluralLabel(),
      ]),
      'relationship' => [
        'id' => "registration_settings",
        'label' => t("$id registration settings"),
        'base' => 'registration_entity',
      ],
    ];
  }
  $data['registration']['host_entity'] = [
    'title' => t('Host entity'),
    'group' => t('Registration'),
    'field' => [
      'title' => t('Host entity'),
      'help' => t('Displays the host entity for a registration.'),
      'id' => 'registration_host_entity',
    ],
  ];
  $data['registration_entity']['settings_operations'] = [
    'title' => t('Settings operations'),
    'help' => t('Provides links to perform settings operations.'),
    'field' => [
      'id' => 'registration_settings_operations',
    ],
  ];
}
